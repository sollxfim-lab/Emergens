[flake8]
# Maximum line length – your code has some long lines, so 120 is reasonable.
max-line-length = 120

# Ignore specific errors that are either stylistic or unavoidable here:
# E203 – whitespace before ':' (conflicts with Black)
# W503 – line break before binary operator (conflicts with Black)
# F401 – imported but unused (many conditional imports)
# F403 – 'from module import *' used (if any)
# F841 – local variable assigned but never used (common in error handling)
# E731 – do not assign a lambda expression, use a def (used occasionally)
ignore = E203, W503, F401, F403, F841, E731

# Exclude common directories and files
exclude =
    .git,
    __pycache__,
    *.pyc,
    *.pyo,
    *.pyd,
    .venv,
    venv,
    env,
    .env,
    build,
    dist,
    *.egg-info,
    .mypy_cache,
    .pytest_cache,
    .tox,
    data,
    logs,
    userdata,
    listschool,
    files,
    wordlist,
    porttxt,
    static/data

# Report all errors (no limit)
count = True

# Show source code for each error
show-source = True

# Statistics: show total errors and warnings
statistics = True

# Per-file ignores (optional, can be customized)
per-file-ignores =
    __init__.py: F401
    main.py: E501, F401, F841
    modules/*: F401, F841
    auth/*: F401
    core/*: F401
    ai_chat/*: F401

# Indicate that the project uses tabs? No, use spaces.
# (flake8 defaults to 4 spaces, which matches your code.)
