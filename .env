# ── Core Flask ───────────────────────────────────────────
PORT=8080
SECRET_KEY=replace_with_random_hex_64_chars
SERVER_LOG_FILE=logs/server.log

# 1 = send session cookie only over HTTPS
# Use 0 for localhost / plain HTTP
SESSION_COOKIE_SECURE=0

# 1 = trust X-Forwarded-For / X-Real-IP
# Set to 1 only if behind Nginx / Cloudflare / reverse proxy
TRUST_PROXY=0

# ── AI Chat ──────────────────────────────────────────────
# Fill one or both. If empty, the corresponding model is marked as not ready.
